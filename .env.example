# Environment Configuration Example for SourceIQ

# General App Settings
ENVIRONMENT=development
LOG_LEVEL=INFO

# AI Engine (Google Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Database (PostgreSQL)
POSTGRES_USER=sourceiq
POSTGRES_PASSWORD=sourceiq_dev_pass
POSTGRES_DB=sourceiq_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://sourceiq:sourceiq_dev_pass@postgres:5432/sourceiq_db

# Redis & Celery
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# JWT Auth
JWT_SECRET_KEY=change_this_to_a_secure_random_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Third-Party Sourcing APIs (Mocked by default if empty)
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
PROVIDER_1688_BASE_URL=
PROVIDER_1688_API_KEY=
PROVIDER_PDD_BASE_URL=
PROVIDER_PDD_API_KEY=
